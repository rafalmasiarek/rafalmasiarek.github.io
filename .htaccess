
# Block access to Jekyll config files and any backups/variants
<FilesMatch "^_config(\.[A-Za-z0-9_-]+)?\.ya?ml(\..*)?$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------
# CUSTOM 403 FOR AI / AUTOMATED AGENTS
# ---------------------------------------------------------
#
# Normal 403 responses keep the default Apache behaviour.
# Known AI crawlers receive /403-ai.txt instead.
#
# /403-ai.txt itself must remain accessible to avoid
# recursively triggering another 403.
#
<If "req('User-Agent') =~ m#(?i)(GPTBot|ChatGPT-User|OAI-SearchBot|Google-Extended|ClaudeBot|Claude-Web|anthropic-ai|PerplexityBot|Perplexity-User|Bytespider|CCBot|cohere-ai|Meta-ExternalAgent|Meta-ExternalFetcher|Amazonbot|Applebot-Extended|Diffbot|FacebookBot|ImagesiftBot|YouBot)#">
  ErrorDocument 403 /403-ai.txt
</If>


<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------
  # BLOCK: known AI crawlers / agents
  # ---------------------------------------------------------
  #
  # These resources remain accessible so automated systems
  # can determine the applicable access and usage policy:
  #
  #   /robots.txt
  #   /llms.txt
  #   /terms-and-conditions.txt
  #   /403-ai.txt
  #
  # All other requests from known AI agents receive
  # HTTP 403 Forbidden.
  #
  RewriteCond %{REQUEST_URI} !^/(?:robots\.txt|llms\.txt|terms-and-conditions\.txt|403-ai\.txt)$ [NC]
  RewriteCond %{HTTP_USER_AGENT} "(GPTBot|ChatGPT-User|OAI-SearchBot|Google-Extended|ClaudeBot|Claude-Web|anthropic-ai|PerplexityBot|Perplexity-User|Bytespider|CCBot|cohere-ai|Meta-ExternalAgent|Meta-ExternalFetcher|Amazonbot|Applebot-Extended|Diffbot|FacebookBot|ImagesiftBot|YouBot)" [NC]
  RewriteRule ^ - [F,L]


  # ---------------------------------------------------------
  # KILL: service worker file -> 410 Gone (no longer available)
  # ---------------------------------------------------------
  RewriteRule ^sw-vinyls\.js$ - [G,L]
  RewriteRule ^sw-vinyls\.js\.br$ - [G,L]


  # ---------------------------------------------------------
  # HTML - serve Brotli-precompressed directory index
  # ---------------------------------------------------------
  RewriteCond %{HTTP:Accept-Encoding} (^|,|\s)br(\s|,|$) [NC]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html.br -s
  RewriteRule ^(.*/)?$ $1index.html.br [QSA,L]


  # ---------------------------------------------------------
  # HTML - serve Brotli-precompressed version when available
  # ---------------------------------------------------------
  RewriteCond %{HTTP:Accept-Encoding} (^|,|\s)br(\s|,|$) [NC]
  RewriteCond %{REQUEST_FILENAME}.br -s
  RewriteRule ^(.+)\.html$ $1.html.br [QSA,L]


  # ---------------------------------------------------------
  # CSS - serve Brotli-precompressed version when available
  # ---------------------------------------------------------
  RewriteCond %{HTTP:Accept-Encoding} (^|,|\s)br(\s|,|$) [NC]
  RewriteCond %{REQUEST_FILENAME}.br -s
  RewriteRule ^(.+)\.css$ $1.css.br [QSA,L]


  # ---------------------------------------------------------
  # JS - serve Brotli-precompressed version when available
  # Skip sw-vinyls.js because it is permanently gone
  # ---------------------------------------------------------
  RewriteCond %{REQUEST_URI} !^/sw-vinyls\.js$
  RewriteCond %{HTTP:Accept-Encoding} (^|,|\s)br(\s|,|$) [NC]
  RewriteCond %{REQUEST_FILENAME}.br -s
  RewriteRule ^(.+)\.js$ $1.js.br [QSA,L]


  # ---------------------------------------------------------
  # EXISTING FILES / DIRECTORIES
  # ---------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]


  # RewriteRule ^(projects|articles)(/.*)?$ /kirby/index.php [QSA,L]

</IfModule>


<IfModule mod_headers.c>

  # ---------------------------------------------------------
  # NO-CACHE for AI / policy / discovery files
  # ---------------------------------------------------------
  <FilesMatch "^(robots\.txt|llms\.txt|terms-and-conditions\.txt|403-ai\.txt|sitemap\.xml)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>


  # ---------------------------------------------------------
  # NO-CACHE for /.well-known/*
  # ---------------------------------------------------------
  <If "%{REQUEST_URI} =~ m#^/\.well-known(?:/|$)#">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </If>


  # ---------------------------------------------------------
  # CORS for the public icon set (assets/img/icons/*.svg)
  # ---------------------------------------------------------
  # These are free, public icons meant to be fetched cross-origin by the
  # rm-icons loader (assets/js/rm-icons.js) from any site - a plain <img>
  # tag never needs CORS, but inlining the SVG via fetch() does.
  <If "%{REQUEST_URI} =~ m#^/assets/img/icons/#">
    Header set Access-Control-Allow-Origin "*"
  </If>


  # ---------------------------------------------------------
  # BROTLI HEADERS
  # ---------------------------------------------------------
  <FilesMatch "\.(html|css|js)(\.br)?$">
    Header merge Vary Accept-Encoding
  </FilesMatch>

  <FilesMatch "\.(html|css|js)\.br$">
    Header set Content-Encoding br
  </FilesMatch>


  # ---------------------------------------------------------
  # VERSIONED ASSETS (CSS/JS) - LONG-TERM, IMMUTABLE CACHE
  # ---------------------------------------------------------
  # Always requested with a ?v=<build-sha> query string (see asset_url in
  # _includes/site-head.html), so a content change always means a new URL -
  # safe to cache forever.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>


  # ---------------------------------------------------------
  # IMAGES - SHORT CACHE (NOT versioned/immutable)
  # ---------------------------------------------------------
  # Unlike CSS/JS, these are plain filenames managed directly on the
  # server (e.g. vinyl covers) and can be overwritten in place without
  # the URL changing - immutable caching here would hide real updates.
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=14400"
  </FilesMatch>


  # ---------------------------------------------------------
  # NO-CACHE for the old service worker file
  # even if someone caches the 410 response
  # ---------------------------------------------------------
  <FilesMatch "^sw-vinyls\.js(\.br)?$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

</IfModule>


# ---------------------------------------------------------
# MIME TYPES / CHARSET
# ---------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/html .html.br
  AddType text/css .css.br
  AddType application/javascript .js.br

  AddType image/webp .webp
  AddType image/avif .avif

  AddDefaultCharset UTF-8
  AddCharset UTF-8 .html .htm .txt .md .xml .json .css .js .map .webmanifest .svg
</IfModule>


# ---------------------------------------------------------
# ERROR DOCUMENTS
# ---------------------------------------------------------
ErrorDocument 404 /404.html

